{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "src/content/physicsChapter1.ts",
    "src/content/energyChapter1.ts",
    "src/content/electricityChapter1.ts",
    "src/content/wavesChapter1.ts",
    "src/content/thermodynamicsChapter1.ts",
    "src/content/legacyMcq.ts",
    "src/content/modules/physicsMotion02.ts",
    "src/content/moduleRegistry.ts"
  ]
}
