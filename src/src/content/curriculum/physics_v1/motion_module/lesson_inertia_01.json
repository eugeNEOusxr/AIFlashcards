  "curiosityNodes": [
    {
      "id": "curiosity-contact-why-touch",
      "trigger": "why",
      "prompt": "Why do some forces require touching?",
      "expansion": "Contact forces need molecules of each surface to press against each other — friction, normal force, and tension all work this way. The bowling ball stays in frame; only contact ripples intensify.",
      "staysInLesson": true,
      "overlayEffect": "contact_ripple"
    },
    {
      "id": "curiosity-contact-what-if-no-gravity",
      "trigger": "what_if",
      "prompt": "What if gravity disappeared for one second?",
      "expansion": "Objects would not feel weight, but contact forces could still exist when you push something. Non-contact fields and contact pushes are independent categories.",
      "staysInLesson": true,
      "overlayEffect": "gravity_pull"
    },
    {
      "id": "curiosity-contact-how-magnet",
      "trigger": "how_change",
      "prompt": "How does magnetism change the chamber?",
      "expansion": "Magnetic arcs and floating metal motifs appear as dynamic overlays. The bowling ball anchor does not move — only the field visuals update.",
      "staysInLesson": true,
      "overlayEffect": "magnet_arcs"
    }
  ],
